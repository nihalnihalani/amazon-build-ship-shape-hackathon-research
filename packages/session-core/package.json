{
  "name": "@atr/session-core",
  "version": "0.1.0",
  "description": "Authoritative TV session state machine, verdicts, reveal, agreement, summary and history derivation (pure TypeScript)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@atr/protocol": "0.1.0"
  }
}
