{
  "name": "@atr/relay",
  "version": "0.1.0",
  "description": "Shared relay core plus local HTTPS/WSS server and AWS Lambda adapter",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "default": "./dist/local/index.js"
    },
    "./aws": {
      "types": "./dist/aws/index.d.ts",
      "default": "./dist/aws/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start:local": "npm run build && node dist/local/main.js",
    "bundle:lambda": "node scripts/bundle-lambda.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "3.1146.0",
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/lib-dynamodb": "3.1146.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2"
  }
}
