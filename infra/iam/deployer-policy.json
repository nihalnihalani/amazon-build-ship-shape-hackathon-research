{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationOnRelayStacksOnly",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:ListChangeSets",
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "arn:aws:cloudformation:*:*:stack/atr-relay-*/*"
    },
    {
      "Sid": "UseTheServerlessTransform",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:*:aws:transform/Serverless-2016-10-31"
    },
    {
      "Sid": "ValidateTemplatesAndListStacks",
      "Effect": "Allow",
      "Action": ["cloudformation:ValidateTemplate", "cloudformation:ListStacks"],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyTheRelayCloudFormationExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/atr-relay-cfn-execution",
      "Condition": { "StringEquals": { "iam:PassedToService": "cloudformation.amazonaws.com" } }
    },
    {
      "Sid": "SamArtifactBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::atr-relay-artifacts-*", "arn:aws:s3:::atr-relay-artifacts-*/*"]
    },
    {
      "Sid": "PublishThePhonePage",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::atr-relay-*-phonebucket-*", "arn:aws:s3:::atr-relay-*-phonebucket-*/*"]
    },
    {
      "Sid": "InvalidatePhonePageCache",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation", "cloudfront:GetDistribution"],
      "Resource": "arn:aws:cloudfront::*:distribution/*"
    },
    {
      "Sid": "ReadRelayLogs",
      "Effect": "Allow",
      "Action": ["logs:FilterLogEvents", "logs:GetLogEvents", "logs:DescribeLogStreams", "logs:StartLiveTail"],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/atr-relay-*:*"
    },
    {
      "Sid": "AlarmDeliveryTestsAndInspection",
      "Effect": "Allow",
      "Action": ["cloudwatch:SetAlarmState", "cloudwatch:DescribeAlarms", "cloudwatch:DescribeAlarmHistory"],
      "Resource": "arn:aws:cloudwatch:*:*:alarm:atr-relay-*"
    },
    {
      "Sid": "InspectAlarmSubscriptions",
      "Effect": "Allow",
      "Action": ["sns:ListSubscriptionsByTopic", "sns:GetTopicAttributes"],
      "Resource": "arn:aws:sns:*:*:atr-relay-*"
    },
    {
      "Sid": "EmergencyLeversOutsideCloudFormation",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:ListVersionsByFunction",
        "lambda:GetAlias",
        "lambda:UpdateAlias"
      ],
      "Resource": ["arn:aws:lambda:*:*:function:atr-relay-*", "arn:aws:lambda:*:*:function:atr-relay-*:*"]
    },
    {
      "Sid": "HashSecretParameter",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter"],
      "Resource": "arn:aws:ssm:*:*:parameter/atr/relay/*"
    },
    {
      "Sid": "DeadlineQueueInspectionAndPurge",
      "Effect": "Allow",
      "Action": ["sqs:GetQueueUrl", "sqs:GetQueueAttributes", "sqs:PurgeQueue", "sqs:ReceiveMessage", "sqs:DeleteMessage"],
      "Resource": "arn:aws:sqs:*:*:atr-relay-*"
    },
    {
      "Sid": "ReadOnlyServiceLimitsForPreflight",
      "Effect": "Allow",
      "Action": ["lambda:GetAccountSettings"],
      "Resource": "*"
    }
  ]
}
