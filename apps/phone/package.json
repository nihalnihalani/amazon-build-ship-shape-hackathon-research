{
  "name": "@atr/phone",
  "version": "0.1.0",
  "description": "Phone companion page: pairing, microphone, local analysis, listener controls",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test-audio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "e2e:flow": "node e2e/flow.mjs",
    "e2e:production": "node e2e/production.mjs",
    "e2e:all": "npm run build && npm run build:test && node e2e/smoke.mjs && node e2e/flow.mjs && node e2e/production.mjs && node e2e/hostile-qr.mjs",
    "e2e:hostile": "node e2e/hostile-qr.mjs"
  },
  "devDependencies": {
    "@atr/phone-mic-meter": "*",
    "@atr/protocol": "*",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "vite": "^7.3.6"
  }
}
